theory Chain
begin

/*
 * The team key chain: versions, roster seals and the owner rule (protocol §4.5, §6.1, §6.4, §6.6,
 * D-19, D-37), against a server that serves, withholds and forges records.
 *
 * Each version names one owner, rosters two accounts (the owner and one member), seals a fresh
 * team key to each, wraps the previous key under the new one, and is signed by the owner of the
 * previous version. A member joins from version 1, with or without the invite anchor, then follows
 * the chain one version at a time, in whatever order and selection the server serves it.
 *
 * Abstractions (formal/README.md):
 * - Signatures are ideal, so the server's store is a fact `!Rec` that only two rules write: an
 *   owner's honest rotation, and a forgery signed with a key the attacker stole (restriction
 *   ForgeOnlyWithStolenKey). A member reads any record in the store, in any order: the server
 *   chooses what it serves. Every record is also published to the attacker.
 * - A version's identity is `<parent, name>` (version 1: `<'v1', name>`), the name public and unique
 *   for honest versions, standing for the version number; "a later version of the same chain" is
 *   the subterm relation. The invite anchor names the whole record, as a record hash does.
 * - One owner per version, two roster entries; an owner may hand over to an account it rosters.
 * - The chain is unbounded, except under DEPTH3 (three versions), where the secrecy lemmas are proven:
 *   their proof otherwise follows the previous-key links without end. Teams, accounts and sessions
 *   stay unbounded there.
 * - Accounts publish one encryption key and one signing key each, in an authentic registry: who
 *   approves which keys is a human's (AS-06), outside this model.
 * - The client keeps one anchor, the version it holds; floors and the vault's anchor are not
 *   modelled (they are local state over the same chain check).
 * - A roster seal binds the team alone, looser than §4.5 (version number and keys hash), and the
 *   previous-key link binds nothing (§4.5: team and version): the attacker may move either between
 *   records, more than the protocol allows.
 * - Readers are the member of a record's second roster slot: an owner never follows the chain as a
 *   reader. Each account has one signing key, never replaced, so the owner key replacement of §6.7
 *   and §6.8 step 3 is not modelled.
 *
 * Mutations (scripts/check-formal.mjs):
 * - MUT_NO_OWNER_RULE: a member accepts a next version signed by anyone.
 * - MUT_SEAL_TO_REMOVED: a rotation also seals the new key to the member it removes.
 */

builtins: asymmetric-encryption, symmetric-encryption

restriction OneRegistration:
  "All a #i #j. Registered(a) @ #i & Registered(a) @ #j ==> #i = #j"

// An honest version's identity is unique, though public.
restriction NewVersion:
  "All v #i #j. NewVersion(v) @ #i & NewVersion(v) @ #j ==> #i = #j"

restriction OneCreation:
  "All t #i #j. TeamCreated(t) @ #i & TeamCreated(t) @ #j ==> #i = #j"

// A record signed by an honest account's key exists only if the account signed it, or its key was stolen.
restriction ForgeOnlyWithStolenKey:
  "All s #i. Forged(s) @ #i ==> Ex #r. RevealSig(s) @ #r & #r < #i"

// An account's published keys (§4.2); its signing key is the `!Sig` capability.
rule Register:
  [ Fr(~e) ]
  --[ Registered($A) ]->
  [ !Enc($A, ~e), !Pk($A, pk(~e)), !Sig($A), Out(<$A, pk(~e)>) ]

// A removed member, a device thief or a script holds an account's encryption key (A4, A5, A7, A9).
rule Reveal_enc:
  [ !Enc(A, e) ] --[ RevealEnc(A) ]-> [ Out(e) ]

// A stolen owner signing key (A6), or an account the attacker holds.
rule Reveal_sig:
  [ !Sig(A) ] --[ RevealSig(A) ]-> [ ]

// §6.3: version 1, owned by its creator, rostering the creator and member B; the invite anchor names it.
rule Create:
  let vid = <'v1', $V>
      rec = <'tkv', $T, vid, $O, pkEO, $B, pkEB,
             aenc(<'roster-seal', $T, ~tk>, pkEO), aenc(<'roster-seal', $T, ~tk>, pkEB), 'none'>
  in
  [ Fr(~tk), !Sig($O), !Pk($O, pkEO), !Pk($B, pkEB) ]
  --[ NewVersion(vid), TeamCreated($T), Version($T, vid, ~tk, $O, $B), Signed($O, vid) ]->
  [ Owner(~tk, $O, $T, vid), !Rec($T, vid, $O, rec), !Invite($T, $B, rec), Out(rec) ]

// §6.6: the owner of the held version writes the next one, for new owner N (rostered) and member C.
// Unbounded for the chain's rules; with DEPTH3, three versions, for the secrecy lemmas, whose proof
// otherwise follows the previous-key links forever.
#ifdef DEPTH3
rule Rotate_to_2:
  let vid = <'v1', v1>
      nvid = <vid, $V>
      rec = <'tkv', T, nvid, $N, pkEN, $C, pkEC,
             aenc(<'roster-seal', T, ~tk>, pkEN), aenc(<'roster-seal', T, ~tk>, pkEC), senc(ptk, ~tk)>
  in
  [ Owner(ptk, O, T, vid), Fr(~tk), !Pk($N, pkEN), !Pk($C, pkEC) ]
  --[ NewVersion(nvid), Version(T, nvid, ~tk, $N, $C), Signed(O, nvid) ]->
  [ Owner(~tk, $N, T, nvid), Rotated(T, nvid, ~tk), !Rec(T, nvid, O, rec), Out(rec) ]

rule Rotate_to_3:
  let vid = <<'v1', v1>, v2>
      nvid = <vid, $V>
      rec = <'tkv', T, nvid, $N, pkEN, $C, pkEC,
             aenc(<'roster-seal', T, ~tk>, pkEN), aenc(<'roster-seal', T, ~tk>, pkEC), senc(ptk, ~tk)>
  in
  [ Owner(ptk, O, T, vid), Fr(~tk), !Pk($N, pkEN), !Pk($C, pkEC) ]
  --[ NewVersion(nvid), Version(T, nvid, ~tk, $N, $C), Signed(O, nvid) ]->
  [ Rotated(T, nvid, ~tk), !Rec(T, nvid, O, rec), Out(rec) ]
#else
rule Rotate:
  let nvid = <vid, $V>
      rec = <'tkv', T, nvid, $N, pkEN, $C, pkEC,
             aenc(<'roster-seal', T, ~tk>, pkEN), aenc(<'roster-seal', T, ~tk>, pkEC), senc(ptk, ~tk)>
  in
  [ Owner(ptk, O, T, vid), Fr(~tk), !Pk($N, pkEN), !Pk($C, pkEC) ]
  --[ NewVersion(nvid), Version(T, nvid, ~tk, $N, $C), Signed(O, nvid) ]->
  [ Owner(~tk, $N, T, nvid), Rotated(T, nvid, ~tk), !Rec(T, nvid, O, rec), Out(rec) ]
#endif

#ifdef MUT_SEAL_TO_REMOVED
// The mutation: the rotation also seals the new key to the member of the version it replaces.
rule Seal_to_removed:
  [ Rotated(T, <vid, n>, tk), !Rec(T, vid, s, <'tkv', T, vid, o, pkO, b, pkB, x, y, w>) ]
  -->
  [ Out(aenc(<'roster-seal', T, tk>, pkB)) ]
#endif

// A record signed with a stolen key: any content the attacker chooses, as version 1 or as the next
// version of any version, signed by account S.
rule Forge:
  let rec = <'tkv', T, vid, NO, pkEN, C, pkEC, s1, s2, w>
  in
  [ !Sig(S), In(rec) ]
  --[ Forged(S) ]->
  [ !Rec(T, vid, S, rec) ]

// The same, built here from a team key the attacker chooses: the attacker could build these seals
// itself; this rule only spares the search from assembling them.
rule Forge_with_key:
  let rec = <'tkv', T, vid, NO, pkEN, C, pkEC,
             aenc(<'roster-seal', T, tk>, pkEN), aenc(<'roster-seal', T, tk>, pkEC), senc(x, tk)>
  in
  [ !Sig(S), In(<T, vid, NO, pkEN, C, pkEC, tk, x>) ]
  --[ Forged(S), ForgedVersion(S, vid) ]->
  [ !Rec(T, vid, S, rec) ]

// §6.4 without an invite anchor: the first contact accepts a version 1 as served, if its own owner
// signed it and it rosters this member (TH-04).
rule Join_first_contact:
  let vid = <'v1', n>
      rec = <'tkv', T, vid, O, pkEO, $M, pk(eM), s1, aenc(<'roster-seal', T, tk>, pk(eM)), 'none'>
  in
  [ !Rec(T, vid, O, rec), !Enc($M, eM) ]
  --[ Joined($M, T, vid), Holds($M, T, vid, O, tk) ]->
  [ Member($M, T, vid, O, tk) ]

// §6.4 with the invite anchor, given out of band: version 1 must be the record it names.
rule Join_with_anchor:
  let vid = <'v1', n>
      rec = <'tkv', T, vid, O, pkEO, $M, pk(eM), s1, aenc(<'roster-seal', T, tk>, pk(eM)), 'none'>
  in
  [ !Invite(T, $M, rec), !Rec(T, vid, O, rec), !Enc($M, eM) ]
  --[ JoinedAnchored($M, T, vid), Holds($M, T, vid, O, tk) ]->
  [ Member($M, T, vid, O, tk) ]

// §4.5 reader check 3 and the roster entry: the next version links to the held one, is signed by
// the held version's owner, and seals its key to this member.
#ifdef MUT_NO_OWNER_RULE
rule Advance:
  let nvid = <vid, nn>
      nxt = <'tkv', T, nvid, NO, pkEN, $M, pk(eM), s1, aenc(<'roster-seal', T, tk2>, pk(eM)), senc(x, tk2)>
  in
  [ Member($M, T, vid, O, tk), !Rec(T, nvid, S, nxt), !Enc($M, eM) ]
  --[ Accept($M, T, vid, nvid, tk2, O), Holds($M, T, nvid, NO, tk2), Link($M, tk, x) ]->
  [ Member($M, T, nvid, NO, tk2) ]
#else
rule Advance:
  let nvid = <vid, nn>
      nxt = <'tkv', T, nvid, NO, pkEN, $M, pk(eM), s1, aenc(<'roster-seal', T, tk2>, pk(eM)), senc(x, tk2)>
  in
  [ Member($M, T, vid, O, tk), !Rec(T, nvid, O, nxt), !Enc($M, eM) ]
  --[ Accept($M, T, vid, nvid, tk2, O), Holds($M, T, nvid, NO, tk2), Link($M, tk, x) ]->
  [ Member($M, T, nvid, NO, tk2) ]
#endif

#ifdef DEPTH3
// An honest chain of three versions is followed.
lemma executable_depth3:
  exists-trace
  "Ex m t v v2 tk o #i #j. JoinedAnchored(m, t, v) @ #i & Accept(m, t, v, v2, tk, o) @ #j
     & not (Ex a #r. RevealEnc(a) @ #r)
     & not (Ex a #r. RevealSig(a) @ #r)"

// SP-04, SP-06: a version's team key is learned only from an account rostered at that version or a
// later version of the same chain. A removed member (rostered only earlier) learns no later key,
// and a stolen owner signing key alone learns none (TH-17 reads future items, not current ones).
lemma team_key_reaches_only_rostered_accounts:
  "All t v tk o b #i #j. Version(t, v, tk, o, b) @ #i & K(tk) @ #j
     ==> Ex v2 tk2 o2 b2 a #k #r. Version(t, v2, tk2, o2, b2) @ #k & (v = v2 | v << v2)
           & (a = o2 | a = b2) & RevealEnc(a) @ #r"

#else
// An honest chain is followed: a member joins with the anchor and accepts the next version.
lemma executable:
  exists-trace
  "Ex m t v v2 tk o #i #j. JoinedAnchored(m, t, v) @ #i & Accept(m, t, v, v2, tk, o) @ #j
     & not (Ex a #r. RevealEnc(a) @ #r)
     & not (Ex a #r. RevealSig(a) @ #r)"

// SP-05: a member accepts a version only if the owner of the version it holds signed it, unless
// that owner's signing key was stolen. A removed owner's signature is refused.
lemma owner_rule:
  "All m t v v2 tk2 o #i. Accept(m, t, v, v2, tk2, o) @ #i
     ==> (Ex #s. Signed(o, v2) @ #s) | (Ex #r. RevealSig(o) @ #r)"

// SP-07: with the invite anchor, a joiner holds the real version 1: its key and its owner.
lemma anchored_join_holds_the_real_version:
  "All m t v o tk #i. JoinedAnchored(m, t, v) @ #i & Holds(m, t, v, o, tk) @ #i
     ==> Ex b #j. Version(t, v, tk, o, b) @ #j"

// Helper: an honest version is followed by at most one honest version, since its owner's state is
// used once.
lemma one_honest_successor [reuse]:
  "All t v n1 n2 tk1 tk2 o1 o2 b1 b2 #i #j. Version(t, <v, n1>, tk1, o1, b1) @ #i & Version(t, <v, n2>, tk2, o2, b2) @ #j
     ==> #i = #j"

// SP-05: members holding one version from one owner never accept two different next versions,
// nor one version with two keys, unless that owner's signing key was stolen (one owner per version
// here; TH-38 for several).
lemma no_fork_without_owner_key:
  "All m1 m2 t v v2 v3 tk2 tk3 o #i #j. Accept(m1, t, v, v2, tk2, o) @ #i & Accept(m2, t, v, v3, tk3, o) @ #j
     ==> (v2 = v3 & tk2 = tk3) | (Ex #r. RevealSig(o) @ #r)"

// §4.5: with no signing key stolen, the previous-key link a member accepts wraps the key it holds
// (review 037 A: a stolen one breaks it).
lemma link_wraps_the_held_key:
  "All m t v v2 tk2 o tk x #i. Accept(m, t, v, v2, tk2, o) @ #i & Link(m, tk, x) @ #i
       & not (Ex a #r. RevealSig(a) @ #r)
     ==> x = tk"

// TH-04, accepted: without the invite anchor, a joiner holds a version 1 nobody created for that team.
lemma attack_TH04_first_contact:
  exists-trace
  "Ex m t v #i #c. Joined(m, t, v) @ #i & TeamCreated(t) @ #c
     & not (Ex tk o b #j. Version(t, v, tk, o, b) @ #j)
     & not (Ex #r. RevealEnc(m) @ #r)"

// TH-38, accepted: with a stolen owner key, a member holding a version accepts a next version that
// isn't the one its owner wrote, while that one exists: the split view, seen from one member.
lemma attack_TH38_split_view:
  exists-trace
  "Ex m t v n2 v3 tk3 o #i #s #f. Accept(m, t, v, v3, tk3, o) @ #i & Signed(o, <v, n2>) @ #s
     & ForgedVersion(o, v3) @ #f & not (<v, n2> = v3)"

// Review 037 A, accepted: with a stolen owner key, a member accepts a version whose link wraps
// another key, so its history no longer opens.
lemma attack_037A_wrong_previous_key:
  exists-trace
  "Ex m t v v2 tk2 o tk x #i #a. Accept(m, t, v, v2, tk2, o) @ #i & Link(m, tk, x) @ #i
     & not (x = tk) & JoinedAnchored(m, t, v) @ #a
     & not (Ex a #r. RevealEnc(a) @ #r)"

#endif

end
