theory Transfer
begin

/*
 * Moving one team's member keys between contexts (protocol §3.8, D-29, D-66).
 *
 * A receiving context C creates a receiver for an expected account A and team T, and sends its
 * request over the integration's channel. The vault of A seals the team's member keys, with
 * their anchor floor, to the request's public key, with A and T inside the box. The receiver
 * opens it once, for the account and team it expects.
 *
 * Abstractions (formal/README.md):
 * - `seal` is ideal public-key encryption with an anonymous sender (`aenc`), as libsodium's
 *   sealed box (§3.2); the context sits inside the box, as the protocol puts it.
 * - A bundle's private keys are one fresh secret `k`; its floor `fl` is public (an anchor).
 * - The request carries the team; in §3.8 it is the receiver's public key alone, and which team
 *   to export is the integration's (D-29). The same on an authentic channel; on one the attacker
 *   writes, it chooses the team either way.
 * - The check against the published `member-keys` record (§3.8 step 3) is left out: it binds
 *   the keys to what the server serves, which the server controls (TH-49).
 * - The channel is the integration's (D-29). The attacker always reads it; `Chan_inject` is a
 *   channel the server or a script can write. Lemmas about the integration's duty exclude
 *   `Inject`; the accepted attacks need it.
 *
 * Mutations, each removing one check (scripts/check-formal.mjs):
 * - MUT_NO_CONTEXT: the box doesn't carry the account and team, and the receiver checks none.
 * - MUT_REUSE: the receiver keeps its secret key after opening a transfer (an extra rule).
 */

builtins: asymmetric-encryption

// §4.3: an account's member keys for a team, with their anchor floor (D-66).
rule Bundle:
  [ Fr(~k), Fr(~fl) ]
  --[ Bundle($A, $T, ~k, ~fl) ]->
  [ !Bundle($A, $T, ~k, ~fl), Out(~fl) ]

// Whoever holds the account key reads every bundle (A7, A9; TH-20).
rule Reveal_bundle:
  [ !Bundle(A, T, k, fl) ]
  --[ RevealBundle(A, T) ]->
  [ Out(k) ]

// §3.8 step 1: a receiver in context C, for account A and team T; the request travels on the channel.
rule Receiver_new:
  [ Fr(~r) ]
  --[ ReceiverNew($C, $A, $T, pk(~r)) ]->
  [ Receiver($C, $A, $T, ~r), !ReceiverKey($C, ~r), ChanOut($C, $A, <'request', $T, pk(~r)>) ]

// A script in the receiving context reads its secret key (A9 there). Read from its own record, so
// a reveal neither consumes nor renews the receiver.
rule Reveal_receiver:
  [ !ReceiverKey(C, r) ]
  --[ RevealReceiver(C) ]->
  [ Out(r) ]

// §3.8 step 2: the vault of A seals the team's bundle to the request's key, with A and T inside.
// §3.8 step 3: the receiver opens one transfer, for the account and team it expects, then wipes its key.
#ifdef MUT_NO_CONTEXT
rule Vault_export:
  [ ChanIn(C, A, <'request', T, pkR>), !Bundle(A, T, k, fl) ]
  --[ Export(A, T, k, fl, pkR) ]->
  [ ChanOut(A, C, <'transfer', aenc(<'team-keys-transfer', k, fl>, pkR)>) ]

rule Receiver_open:
  [ Receiver(C, A, T, r), ChanIn(S, C, <'transfer', aenc(<'team-keys-transfer', k, fl>, pk(r))>) ]
  --[ Accept(C, A, T, k, fl, pk(r)) ]->
  [ Opened(C, A, T, r) ]
#else
rule Vault_export:
  [ ChanIn(C, A, <'request', T, pkR>), !Bundle(A, T, k, fl) ]
  --[ Export(A, T, k, fl, pkR) ]->
  [ ChanOut(A, C, <'transfer', aenc(<'team-keys-transfer', A, T, k, fl>, pkR)>) ]

rule Receiver_open:
  [ Receiver(C, A, T, r), ChanIn(S, C, <'transfer', aenc(<'team-keys-transfer', A, T, k, fl>, pk(r))>) ]
  --[ Accept(C, A, T, k, fl, pk(r)) ]->
  [ Opened(C, A, T, r) ]
#endif

#ifdef MUT_REUSE
// The mutation: a receiver that keeps its key after opening, so it can open again.
rule Reuse_receiver:
  [ Opened(C, A, T, r) ]
  -->
  [ Receiver(C, A, T, r) ]
#endif

// The integration's channel: the attacker reads everything and may replay it.
rule Chan_send:
  [ ChanOut(S, R, m) ]
  --[ Send(S, R, m) ]->
  [ !Chan(S, R, m), Out(m) ]

rule Chan_recv:
  [ !Chan(S, R, m) ]
  -->
  [ ChanIn(S, R, m) ]

// A channel someone else can write: the server relaying it, or a script posting on it (TH-39, TH-49).
rule Chan_inject:
  [ In(<S, R, m>) ]
  --[ Inject(S, R, m) ]->
  [ ChanIn(S, R, m) ]

// An honest run completes over the integration's channel.
lemma executable:
  exists-trace
  "Ex c a t k fl p #i. Accept(c, a, t, k, fl, p) @ #i
     & not (Ex s r m #j. Inject(s, r, m) @ #j)
     & not (Ex a2 t2 #j. RevealBundle(a2, t2) @ #j)
     & not (Ex c2 #j. RevealReceiver(c2) @ #j)"

// SP-02: on a channel only the integration writes, a team's member keys stay secret, though the
// attacker reads every request and transfer, unless the account key or a receiver's secret leaked.
lemma keys_secret_on_authentic_channel:
  "All a t k fl #i #j. Bundle(a, t, k, fl) @ #i & K(k) @ #j
     ==> (Ex #r. RevealBundle(a, t) @ #r)
       | (Ex c #r. RevealReceiver(c) @ #r)
       | (Ex s r m #x. Inject(s, r, m) @ #x)"

// SP-02: on that channel, a receiver accepts only keys the vault exported to it.
lemma accepts_only_exports_on_authentic_channel:
  "All c a t k fl p #i. Accept(c, a, t, k, fl, p) @ #i
     ==> (Ex #j. Export(a, t, k, fl, p) @ #j & #j < #i)
       | (Ex s r m #x. Inject(s, r, m) @ #x)"

// SP-02, even on a channel the attacker writes: a receiver for account a and team t accepts another
// team's or account's real keys only if the keys leaked: the account key, a receiver's secret, or
// an export to a key no receiver made (a substituted request, TH-39).
lemma transfer_opens_only_for_its_account_and_team:
  "All c a t k fl p a2 t2 #i #j. Accept(c, a, t, k, fl, p) @ #i & Bundle(a2, t2, k, fl) @ #j
     ==> ((a = a2) & (t = t2))
       | (Ex #r. RevealBundle(a2, t2) @ #r)
       | (Ex c2 #r. RevealReceiver(c2) @ #r)
       | (Ex q #e. Export(a2, t2, k, fl, q) @ #e & not (Ex c3 a3 t3 #n. ReceiverNew(c3, a3, t3, q) @ #n))"

// §3.8 step 3, even on a channel the attacker writes: a receiver opens one transfer.
lemma receiver_opens_once:
  "All c a t k fl k2 fl2 p #i #j. Accept(c, a, t, k, fl, p) @ #i & Accept(c, a, t, k2, fl2, p) @ #j
     ==> #i = #j"

// D-66, even on a channel the attacker writes: real keys arrive with the floor the vault holds with
// them, unless the keys leaked as above and the attacker sealed them with another floor.
lemma floor_arrives_intact:
  "All c a t k fl fl2 p a2 t2 #i #j. Accept(c, a, t, k, fl, p) @ #i & Bundle(a2, t2, k, fl2) @ #j
     ==> (fl = fl2)
       | (Ex #r. RevealBundle(a2, t2) @ #r)
       | (Ex c2 #r. RevealReceiver(c2) @ #r)
       | (Ex q #e. Export(a2, t2, k, fl2, q) @ #e & not (Ex c3 a3 t3 #n. ReceiverNew(c3, a3, t3, q) @ #n))"

// TH-39, accepted: on a channel the attacker writes, a substituted request receives the keys.
lemma attack_TH39_substituted_request:
  exists-trace
  "Ex a t k fl #i #j. Bundle(a, t, k, fl) @ #i & K(k) @ #j
     & not (Ex #r. RevealBundle(a, t) @ #r)
     & not (Ex c #r. RevealReceiver(c) @ #r)"

// TH-49, accepted: on a channel the attacker writes, a receiver accepts keys no vault exported.
lemma attack_TH49_forged_transfer:
  exists-trace
  "Ex c a t k fl p #i. Accept(c, a, t, k, fl, p) @ #i
     & not (Ex #j. Export(a, t, k, fl, p) @ #j)
     & not (Ex a2 t2 #r. RevealBundle(a2, t2) @ #r)
     & not (Ex c2 #r. RevealReceiver(c2) @ #r)"

end
